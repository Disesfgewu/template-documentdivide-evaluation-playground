# LAB API settings (all required unless noted). Copy values into your shell; no .env file is read.
LAB_ENV=dev                       # dev | test | prod
LAB_PROVIDER_MODE=mock            # mock (deterministic local fakes) | real (refused until a real adapter exists, T84)
LAB_DATABASE_URL=postgresql://lab:lab-dev-only@127.0.0.1:55432/lab
LAB_ARTIFACT_ROOT=/absolute/path/to/artifacts
# LAB_DB_CONNECT_TIMEOUT_S=3      # optional, (0, 30]
