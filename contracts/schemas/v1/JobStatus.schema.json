{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 200,
          "title": "Claims",
          "type": "array"
        },
        "text": {
          "maxLength": 32000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "claims"
      ],
      "title": "Answer",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "hit_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Hit Id",
          "type": "string"
        },
        "region_indices": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Region Indices",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "hit_id",
        "region_indices"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ErrorBody": {
      "additionalProperties": false,
      "description": "Every non-2xx response and every failed job's `error`. Must not carry\ncredentials or gold content; details is a bounded, typed-free object.",
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "retry_after": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "request_id",
        "details"
      ],
      "title": "ErrorBody",
      "type": "object"
    },
    "Hit": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 32000,
          "title": "Content",
          "type": "string"
        },
        "hit_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Hit Id",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/SourceRegion"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Regions",
          "type": "array"
        }
      },
      "required": [
        "hit_id",
        "rank",
        "content",
        "regions"
      ],
      "title": "Hit",
      "type": "object"
    },
    "MethodRevisionRef": {
      "additionalProperties": false,
      "properties": {
        "method_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "revision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "method_id",
        "revision"
      ],
      "title": "MethodRevisionRef",
      "type": "object"
    },
    "PrepareResult": {
      "additionalProperties": false,
      "description": "Terminal result of a succeeded prepare job.",
      "properties": {
        "document_hashes": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 128,
            "minLength": 1
          },
          "title": "Document Hashes",
          "type": "object"
        },
        "index_fingerprint": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Index Fingerprint",
          "type": "string"
        },
        "index_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Index Id",
          "type": "string"
        },
        "method_revision": {
          "$ref": "#/$defs/MethodRevisionRef"
        },
        "stats": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stats"
        },
        "status": {
          "const": "ready",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "index_id",
        "index_fingerprint",
        "document_hashes",
        "method_revision",
        "status"
      ],
      "title": "PrepareResult",
      "type": "object"
    },
    "QueryResponse": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "$ref": "#/$defs/Answer"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 1000,
          "title": "Citations",
          "type": "array"
        },
        "index_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Index Id",
          "type": "string"
        },
        "protocol_version": {
          "pattern": "^[0-9]+\\.[0-9]+$",
          "title": "Protocol Version",
          "type": "string"
        },
        "question_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Question Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "retrieval_trace": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Trace"
        },
        "retrieved_hits": {
          "items": {
            "$ref": "#/$defs/Hit"
          },
          "maxItems": 200,
          "title": "Retrieved Hits",
          "type": "array"
        },
        "status": {
          "enum": [
            "answered",
            "abstained"
          ],
          "title": "Status",
          "type": "string"
        },
        "telemetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Telemetry"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "question_id",
        "index_id",
        "status",
        "answer",
        "retrieved_hits",
        "citations"
      ],
      "title": "QueryResponse",
      "type": "object"
    },
    "RegionKind": {
      "enum": [
        "text",
        "table",
        "figure",
        "image",
        "formula",
        "page"
      ],
      "title": "RegionKind",
      "type": "string"
    },
    "SourceRegion": {
      "additionalProperties": false,
      "description": "A region on one physical PDF page. Origin top-left after applying page\nrotation, normalized to the visible CropBox.",
      "properties": {
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "document_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Sha256",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RegionKind"
        },
        "page_index": {
          "minimum": 0,
          "title": "Page Index",
          "type": "integer"
        },
        "page_label": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Label"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        }
      },
      "required": [
        "document_id",
        "document_sha256",
        "page_index",
        "bbox",
        "kind",
        "quote"
      ],
      "title": "SourceRegion",
      "type": "object"
    },
    "Telemetry": {
      "additionalProperties": false,
      "description": "Method self-report. Every key is required; unknown values are null\n(0 means a confirmed zero, SPEC 16.1).",
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latency Ms"
        },
        "model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Calls"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "retrieval_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieval Calls"
        }
      },
      "required": [
        "latency_ms",
        "retrieval_calls",
        "model_calls",
        "input_tokens",
        "output_tokens"
      ],
      "title": "Telemetry",
      "type": "object"
    }
  },
  "$id": "lab-contracts/v1/JobStatus.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "GET /v1/jobs/{job_id}. Only succeeded carries a terminal result;\nfailed carries error. HTTP 200 only means the lookup itself succeeded.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorBody"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "prepare",
        "query"
      ],
      "title": "Kind",
      "type": "string"
    },
    "progress": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Progress"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrepareResult"
        },
        {
          "$ref": "#/$defs/QueryResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "kind",
    "status",
    "progress"
  ],
  "title": "JobStatus",
  "type": "object"
}
