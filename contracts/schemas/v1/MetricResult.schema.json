{
  "$id": "lab-contracts/v1/MetricResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "denominator": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Denominator"
    },
    "display_value": {
      "anyOf": [
        {
          "pattern": "^[0-9]{1,3}\\.[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Display Value"
    },
    "grader_revision": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Grader Revision",
      "type": "string"
    },
    "metric": {
      "enum": [
        "recall_at_k",
        "complete_at_k",
        "correctness",
        "textual_consistency",
        "localization_precision",
        "citation_precision",
        "citation_completeness",
        "faithfulness"
      ],
      "title": "Metric",
      "type": "string"
    },
    "numerator": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Numerator"
    },
    "question_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Question Id",
      "type": "string"
    },
    "raw_value": {
      "anyOf": [
        {
          "maximum": 100.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Raw Value"
    },
    "reason_codes": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "status": {
      "enum": [
        "scored",
        "not_applicable",
        "pending",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "support_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Support Refs",
      "type": "array"
    }
  },
  "required": [
    "question_id",
    "metric",
    "status",
    "raw_value",
    "display_value",
    "numerator",
    "denominator",
    "reason_codes",
    "grader_revision",
    "support_refs"
  ],
  "title": "MetricResult",
  "type": "object"
}
