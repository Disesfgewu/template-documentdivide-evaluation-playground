{
  "$id": "lab-contracts/v1/PageRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "page_size": {
      "default": 50,
      "maximum": 200,
      "minimum": 1,
      "title": "Page Size",
      "type": "integer"
    }
  },
  "title": "PageRequest",
  "type": "object"
}
