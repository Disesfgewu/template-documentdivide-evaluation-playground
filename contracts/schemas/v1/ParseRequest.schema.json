      "type": "string"
    },
    "operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "page_indices": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 1,
      "title": "Page Indices",
      "type": "array"
    },
    "profile_revision": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
